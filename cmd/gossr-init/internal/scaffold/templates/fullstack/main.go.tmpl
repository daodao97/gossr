package main

import (
	"context"
	"log"
	"net/http"
	"time"

	"github.com/daodao97/gossr"
	"github.com/gin-gonic/gin"
	frontend "__GOSSR_GO_MODULE__/web"
)

// pageDocument is the shared page snapshot. The Vue side mirrors it in
// web/src/page-document.ts; keep the two in sync.
type pageDocument struct {
	SchemaVersion int      `json:"schema_version"`
	URL           string   `json:"url"`
	Page          pageData `json:"page"`
}

type pageData struct {
	Kind        string `json:"kind"`
	Message     string `json:"message"`
	GeneratedAt string `json:"generated_at"`
}

// resolvePage serves both the initial document and in-app navigation from one
// place. Return Redirect for auth flows, a non-200 Status for missing pages.
func resolvePage(_ context.Context, request gossr.PageRequest) (gossr.PageResult, error) {
	document := pageDocument{
		SchemaVersion: 1,
		URL:           request.URL.RequestURI(),
		Page: pageData{
			Kind:        "home",
			Message:     "Hello from Go",
			GeneratedAt: time.Now().Format(time.RFC3339),
		},
	}
	status := http.StatusOK
	if request.URL.Path != "/" {
		document.Page.Kind = "not_found"
		status = http.StatusNotFound
	}

	payload, err := gossr.ObjectPayload(document)
	if err != nil {
		return gossr.PageResult{}, err
	}
	return gossr.PageResult{Payload: payload, Status: status}, nil
}

func main() {
	router := gin.New()
	router.Use(gin.Logger(), gin.Recovery())
	if err := router.SetTrustedProxies(nil); err != nil {
		log.Fatal(err)
	}

	runtime, err := gossr.New(gossr.Config{Bundle: frontend.Dist})
	if err != nil {
		log.Fatal(err)
	}
	if err := runtime.MountGin(router, gossr.GinOptions{
		Resolver: resolvePage,
	}); err != nil {
		_ = runtime.Close()
		log.Fatal(err)
	}

	log.Println("gossr app is running at http://127.0.0.1:8080")
	err = router.Run("127.0.0.1:8080")
	if closeErr := runtime.Close(); closeErr != nil {
		log.Printf("close SSR runtime failed: %v", closeErr)
	}
	if err != nil {
		log.Fatal(err)
	}
}
