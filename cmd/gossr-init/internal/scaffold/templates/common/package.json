{
  "name": "__GOSSR_PROJECT_NAME__",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3333",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --ssrManifest --outDir ./dist/client --emptyOutDir",
    "build:server": "vite build -c vite.config.server.ts --outDir ./dist/server --emptyOutDir"
  },
  "dependencies": {
    "@vue/server-renderer": "^3.5.39",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "@daodao97/gossr-vue": "github:daodao97/gossr#main&path:/packages/gossr-vue"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
