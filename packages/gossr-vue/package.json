{
  "name": "@daodao97/gossr-vue",
  "version": "0.1.0-git",
  "description": "Vue SSR runtime and Vite presets for gossr",
  "type": "module",
  "sideEffects": false,
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:exports": "node scripts/check-exports.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm test && pnpm typecheck && pnpm build && pnpm test:exports"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.40",
    "vite": "^8.1.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.40",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gossr-build": "./bin/gossr-build.mjs"
  }
}
