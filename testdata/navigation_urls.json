{
  "valid": [
    {
      "name": "root",
      "input": "/",
      "canonical": "/"
    },
    {
      "name": "encoded slash",
      "input": "/a%2Fb",
      "canonical": "/a%2Fb"
    },
    {
      "name": "force query",
      "input": "/foo?",
      "canonical": "/foo?"
    },
    {
      "name": "raw query order and encoding",
      "input": "/search?b=2&a=%2F&a=1",
      "canonical": "/search?b=2&a=%2F&a=1"
    },
    {
      "name": "encoded hash in query",
      "input": "/search?q=%23hash",
      "canonical": "/search?q=%23hash"
    },
    {
      "name": "encoded space",
      "input": "/search%20results?q=two%20words",
      "canonical": "/search%20results?q=two%20words"
    },
    {
      "name": "percent-encoded unicode",
      "input": "/%E4%B8%AD%E6%96%87?name=%E6%B5%8B%E8%AF%95",
      "canonical": "/%E4%B8%AD%E6%96%87?name=%E6%B5%8B%E8%AF%95"
    }
  ],
  "invalid": [
