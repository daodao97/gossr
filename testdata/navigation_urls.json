    {
      "name": "protocol relative URL",
      "input": "//evil.example/path"
    },
    {
      "name": "relative path",
      "input": "relative/path"
    },
    {
      "name": "query without path",
      "input": "?query=1"
    },
    {
      "name": "leading whitespace",
      "input": " /space"
    },
    {
      "name": "raw path space",
      "input": "/a b"
    },
    {
      "name": "fragment",
      "input": "/page#fragment"
    },
    {
      "name": "raw backslash",
      "input": "/a\\b"
    },
    {
      "name": "encoded backslash",
      "input": "/a%5Cb"
    },
    {
      "name": "raw control",
      "input": "/a\u0000b"
