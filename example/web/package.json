{
  "name": "gossr-example-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3333",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "gossr-build --smoke-snapshot testdata/smoke-snapshot.json --smoke-url /__gossr_build_smoke__ --smoke-expect \"404 Not Found\"",
    "verify:bundle": "gossr-build verify"
  },
  "dependencies": {
    "@vue/server-renderer": "^3.5.39",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "@daodao97/gossr-vue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
